# Copied to .env by start.sh / start.bat when .env does not exist. Real environment variables win.
AIWB_HOST=127.0.0.1
AIWB_PORT=5050
# SQLite file for projects, edits and feedback (relative paths are inside the project folder)
AIWB_DB=data/projects.sqlite3
# Optional: where ml/train.py finds the team's ML-Training-App (only needed to retrain)
# ML_TRAINING_APP=../ML-Training-App
