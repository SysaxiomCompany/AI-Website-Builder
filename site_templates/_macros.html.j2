{# Fixed inline icon set (stroke icons). The icon name must be one of these; anything else falls back to "star". #}
{% macro icon(name) -%}
<span class="icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false">
{%- if name == 'heart' %}<path d="M12 21s-7-4.6-9.3-9A5.3 5.3 0 0 1 12 6a5.3 5.3 0 0 1 9.3 6c-2.3 4.4-9.3 9-9.3 9z"/>
{%- elif name == 'bolt' %}<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>
{%- elif name == 'shield' %}<path d="M12 3 5 6v6c0 4.4 3 7.4 7 9 4-1.6 7-4.6 7-9V6z"/>
{%- elif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == 'check' %}<path d="m5 12 5 5 9-10"/>
{%- elif name == 'book' %}<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/>
{%- elif name == 'camera' %}<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>
{%- else %}<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>
{%- endif -%}
</svg></span>
{%- endmacro %}
