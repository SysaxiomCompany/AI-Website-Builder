<section id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title">{{ c.title }}</h2>
    <div class="gallery-grid">
      {%- for item in c["items"] %}
      <figure class="tile" role="img" aria-label="{{ item }}"><figcaption>{{ item }}</figcaption></figure>
      {%- endfor %}
    </div>
  </div>
</section>
